---
const { title = 'TradePro · Opera en los mercados globales' } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style is:global>
    :root{--bg:#070a10;--ink:#eaf2f8;--mute:#8a9bb0;--cy:#6ee7f9;--bl:#4f9dff;--up:#2ee6a6;--dn:#ff5d6c;--line:rgba(255,255,255,.09);--glass:rgba(12,17,26,.74)}
    *{box-sizing:border-box;margin:0}
    html{scroll-behavior:smooth;background:var(--bg);scroll-padding-top:120px}
    body{font-family:'Sora',system-ui,sans-serif;color:var(--ink);background:var(--bg);overflow-x:hidden;-webkit-font-smoothing:antialiased}
    a{color:inherit;text-decoration:none}.mono{font-family:'IBM Plex Mono',monospace}
    #bg{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;opacity:.7}
    main,header,footer{position:relative;z-index:2}
    :focus-visible{outline:2px solid var(--cy);outline-offset:3px}
    .wrap{max-width:1300px;margin:auto;padding:0 clamp(16px,5vw,48px)}
    .s{padding:clamp(60px,9vw,120px) 0}
    .glass{background:var(--glass);backdrop-filter:blur(16px);border:1px solid var(--line);border-radius:18px}
    h2.t{font-size:clamp(1.8rem,3.6vw,3rem);font-weight:800;letter-spacing:-.02em;max-width:18em;margin-bottom:.8rem}
    .sub{color:var(--mute);max-width:38em;line-height:1.65;margin-bottom:2.6rem}
    .tape{position:fixed;top:0;left:0;right:0;height:46px;z-index:60;background:rgba(7,10,16,.92);border-bottom:1px solid var(--line);overflow:hidden}
    header{position:fixed;top:46px;left:0;right:0;z-index:50;height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(16px,5vw,64px);background:rgba(7,10,16,.72);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
    .logo{font-weight:800;font-size:1.4rem}.logo b{color:var(--cy)}
    nav{display:flex;gap:1.8rem;font-size:.9rem;color:var(--mute)}nav a:hover{color:var(--ink)}
    .hr{display:flex;gap:.6rem;align-items:center}
    .btn{display:inline-flex;align-items:center;justify-content:center;padding:.8rem 1.4rem;border-radius:10px;font:600 .95rem 'Sora',sans-serif;border:1px solid var(--line);color:var(--ink);background:rgba(255,255,255,.03);cursor:pointer;transition:transform .2s,box-shadow .2s,border-color .2s}
    .btn:hover{border-color:var(--cy)}
    .btn.p{background:linear-gradient(135deg,var(--cy),var(--bl));color:#04121c;border:0;box-shadow:0 0 28px rgba(110,231,249,.25)}
    .btn.p:hover{transform:translateY(-2px);box-shadow:0 6px 36px rgba(110,231,249,.45)}
    header .btn{padding:.5rem 1rem;font-size:.84rem}
    .tvw{height:clamp(440px,72vh,640px);width:100%}.tvw.tall{height:clamp(480px,78vh,700px)}.tvw.hc{height:clamp(380px,62vh,600px)}
    .glass:has(>.tvw){background:rgba(9,13,20,.94)}[hidden]{display:none!important}
    input,select,textarea{width:100%;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:10px;padding:.85rem 1rem;color:var(--ink);font:400 .95rem 'Sora',sans-serif}
    input:focus,select:focus,textarea:focus{outline:none;border-color:var(--cy)}select option{background:#0c111a}
    label{display:block;font-size:.8rem;color:var(--mute);margin-bottom:6px}
    footer{background:rgba(7,10,16,.92);border-top:1px solid var(--line);padding:56px 0 28px;color:var(--mute);font-size:.88rem;line-height:1.7}
    .fg{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:32px;margin-bottom:36px}
    footer h4{color:var(--ink);font-size:.85rem;margin-bottom:.8rem}footer a{display:block;padding:2px 0}footer a:hover{color:var(--cy)}
    .risk{border-top:1px solid var(--line);padding-top:22px;font-size:.76rem}
    @media(max-width:900px){nav{position:absolute;top:100%;left:0;right:0;overflow-x:auto;white-space:nowrap;padding:10px 16px;background:rgba(7,10,16,.92);font-size:.82rem}.fg{grid-template-columns:1fr 1fr}}
    @media(max-width:520px){header .btn:not(.p){display:none}.fg{grid-template-columns:1fr}.logo{font-size:1.2rem}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important}}
  </style>
</head>
<body>
  <canvas id="bg" aria-hidden="true"></canvas>
  <div class="tape tradingview-widget-container" id="tape"></div>
  <header>
    <a href="/" class="logo">TRADE<b>PRO</b></a>
    <nav>
      <a href="/#caracteristicas">Características</a><a href="/#mercados">Mercados</a><a href="/#noticias">Noticias</a>
      <a href="/#planes">Planes</a><a href="/#faq">FAQ</a><a href="/#contacto">Contacto</a>
    </nav>
    <div class="hr"><a href="/login" class="btn">Iniciar sesión</a><a href="/registro" class="btn p">Abrir cuenta</a></div>
  </header>

  <slot />

  <footer>
    <div class="wrap">
      <div class="fg">
        <div><a href="/" class="logo" style="color:var(--ink);font-size:1.3rem">TRADE<b>PRO</b></a><p style="margin-top:.6rem;max-width:24em">Plataforma de trading con gráficos profesionales, datos de mercado en vivo y herramientas de análisis.</p></div>
        <div><h4>Producto</h4><a href="/#caracteristicas">Características</a><a href="/#mercados">Mercados</a><a href="/#noticias">Noticias</a><a href="/#planes">Planes</a></div>
        <div><h4>Soporte</h4><a href="/#faq">Preguntas frecuentes</a><a href="/#contacto">Contacto</a><a href="/login">Iniciar sesión</a><a href="/registro">Crear cuenta</a></div>
        <div><h4>Legal</h4><a href="/terminos#terminos">Términos y condiciones</a><a href="/terminos#privacidad">Política de privacidad</a><a href="/terminos#riesgos">Aviso de riesgos</a><a href="/terminos#cookies">Cookies</a></div>
      </div>
      <p class="risk"><b>Aviso de riesgo:</b> operar con acciones, divisas, criptomonedas y derivados conlleva un alto riesgo y puede resultar en la pérdida de todo el capital invertido. El contenido es informativo y no constituye asesoría financiera. Datos y gráficos proporcionados por TradingView. © 2026 TradePro. Todos los derechos reservados.</p>
    </div>
  </footer>

  <script>
    import './../scripts/bg.js';
    import { tv } from '../scripts/tv.js';
    const p = (s, t) => ({ proName: s, title: t });
    tv('tape', 'ticker-tape', {
      symbols: [p('FOREXCOM:SPXUSD','S&P 500'),p('AMEX:SPY','SPY'),p('NASDAQ:QQQ','QQQ'),p('FOREXCOM:NSXUSD','Nasdaq 100'),p('NASDAQ:NVDA','NVDA'),p('NASDAQ:AAPL','AAPL'),p('NASDAQ:MSFT','MSFT'),p('NASDAQ:TSLA','TSLA'),p('BITSTAMP:BTCUSD','Bitcoin'),p('BITSTAMP:ETHUSD','Ethereum'),p('OANDA:XAUUSD','Oro'),p('FX:EURUSD','EUR/USD')],
      showSymbolLogo: true, displayMode: 'adaptive', width: '100%', height: '100%'
    }, false);
  </script>
</body>
</html>
