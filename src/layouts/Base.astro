---
import "../styles/global.css";
import TvWidget from "../components/TvWidget.astro";
import Logo from "../components/Logo.astro";
import { MARKETS, TAPE } from "../data/markets";
import { tickerTape } from "../lib/tradingview";
import { href } from "../lib/url";
import { CSP } from "../lib/security";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TradePro: market news and live prices",
  description = "The headlines moving stocks, crypto, futures, commodities and currencies, with live prices and charts from TradingView.",
} = Astro.props;

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
const nav = [
  { label: "News", path: "/news/" },
  { label: "Markets", path: "/markets/" },
  { label: "Chart", path: "/chart/" },
  { label: "Calendar", path: "/calendar/" },
  { label: "About", path: "/about/" },
];
const isActive = (p: string) => path === p || (p !== "/" && path.startsWith(p));
---

<!doctype html>
<html lang="en" translate="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={CSP.meta} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06070d" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <canvas class="trend-field" data-trend-field aria-hidden="true"></canvas>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="tape">
      <TvWidget url={tickerTape(TAPE)} title="Live prices ticker" size="tape" eager />
    </div>

    <header class="site-header">
      <div class="shell header-row">
        <a class="brand" href={href("/")} aria-label="TradePro home">
          <Logo />
          <span class="brand-word">TradePro</span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
          <span class="nav-toggle-bars" aria-hidden="true"></span>
          <span class="visually-hidden">Menu</span>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={href(item.path)} aria-current={isActive(item.path) ? "page" : undefined}>{item.label}</a>
          ))}
          <span class="utc" title="Coordinated Universal Time">
            <span class="live-dot" aria-hidden="true"></span>
            <span class="mono" data-utc-clock>--:--:--</span> UTC
          </span>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <a class="brand" href={href("/")} aria-label="TradePro home"><Logo /><span class="brand-word">TradePro</span></a>
          <p>The news and numbers moving global markets, in one place. Built as a portfolio project.</p>
        </div>
        <nav aria-label="Markets">
          <h2 class="footer-heading">Markets</h2>
          {MARKETS.map((m) => <a href={href(`/markets/${m.slug}/`)}>{m.short}</a>)}
        </nav>
        <nav aria-label="TradePro">
          <h2 class="footer-heading">TradePro</h2>
          <a href={href("/news/")}>Market news</a>
          <a href={href("/calendar/")}>Economic calendar</a>
          <a href={href("/about/")}>About this project</a>
          <a href={href("/legal/")}>Disclaimer and privacy</a>
        </nav>
      </div>
      <div class="shell footer-note">
        <p>
          Prices, charts and headlines are provided by
          <a href="https://www.tradingview.com/" rel="noopener noreferrer" target="_blank">TradingView</a>
          and may be delayed. TradePro is for information only and is not financial advice.
        </p>
        <p>&copy; 2026 TradePro</p>
      </div>
    </footer>

    <script>
      import "../scripts/app.ts";
    </script>
  </body>
</html>
