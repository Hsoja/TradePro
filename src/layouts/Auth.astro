---
import Base from './Base.astro';
const { title, active } = Astro.props;
---
<Base title={title}>
<main class="wrap auth">
  <div class="glass box">
    <div class="tabs"><a href="/login" class={active === 'login' ? 'on' : ''}>Iniciar sesión</a><a href="/registro" class={active === 'registro' ? 'on' : ''}>Crear cuenta</a></div>
    <slot />
  </div>
</main>
</Base>
<style is:global>
  .auth{min-height:100vh;display:grid;place-items:center;padding-top:170px;padding-bottom:60px}
  .box{width:100%;max-width:440px;padding:32px}.box h1{font-size:1.6rem;margin-bottom:.4rem}.box form{display:grid;gap:14px}
  .tabs{display:flex;gap:6px;margin-bottom:22px}.tabs a{flex:1;text-align:center;font:500 .88rem 'Sora',sans-serif;color:var(--mute);border:1px solid var(--line);border-radius:10px;padding:.6rem;transition:all .2s}
  .tabs a:hover{color:var(--ink)}.tabs a.on{color:var(--cy);border-color:rgba(110,231,249,.5);background:rgba(110,231,249,.08)}
  .note{font-size:.8rem;color:var(--mute);line-height:1.5}.alt{font-size:.85rem;color:var(--mute);text-align:center}.alt a{color:var(--cy)}
</style>
