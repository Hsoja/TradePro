---
import Base from "../layouts/Base.astro";
import TvWidget from "../components/TvWidget.astro";
import { newsTimeline, type FeedMarket } from "../lib/tradingview";

const feeds: { id: string; label: string; market?: FeedMarket; intro: string }[] = [
  { id: "top", label: "Top stories", intro: "The most important headlines across every market." },
  { id: "stocks", label: "Stocks", market: "stock", intro: "Earnings, guidance, deals and analyst calls." },
  { id: "indices", label: "Indices", market: "index", intro: "What's driving the S&P 500, Nasdaq, Dow and global benchmarks." },
  { id: "crypto", label: "Crypto", market: "crypto", intro: "Bitcoin, Ethereum, regulation and exchange news." },
  { id: "futures", label: "Futures and commodities", market: "futures", intro: "Energy, metals, grains and index futures." },
  { id: "forex", label: "Forex", market: "forex", intro: "Central banks, rates and the moves in major currency pairs." },
];
---

<Base title="Market news | TradePro" description="Live headlines for stocks, indices, crypto, futures, commodities and forex.">
  <section class="page-head shell">
    <p class="kicker"><span class="live-dot" aria-hidden="true"></span>Updated continuously</p>
    <h1 class="title-lg">Market news</h1>
    <p class="lede">Pick a market to see the stories moving it. Headlines open on TradingView in a new tab.</p>
  </section>

  <section class="shell section-tight" data-tabs>
    <div class="tablist tablist-scroll" role="tablist" aria-label="News by market">
      {
        feeds.map((f, i) => (
          <button role="tab" id={`tab-${f.id}`} aria-controls={`panel-${f.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? undefined : -1}>
            {f.label}
          </button>
        ))
      }
    </div>
    {
      feeds.map((f, i) => (
        <div class="panel" role="tabpanel" id={`panel-${f.id}`} aria-labelledby={`tab-${f.id}`} hidden={i !== 0}>
          <p class="panel-intro muted">{f.intro}</p>
          <TvWidget url={newsTimeline(f.market)} title={`${f.label} news`} size="xl" deferred={i !== 0} eager={i === 0} />
        </div>
      ))
    }
  </section>
</Base>
