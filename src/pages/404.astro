---
import Base from "../layouts/Base.astro";
import { href } from "../lib/url";
---

<Base title="Page not found | TradePro">
  <section class="shell error-page">
    <p class="error-code mono" aria-hidden="true">404</p>
    <h1 class="title-lg">This page doesn't exist</h1>
    <p class="lede">The link may be old. The markets are still moving, though.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={href("/")}>Go to the home page</a>
      <a class="btn btn-ghost" href={href("/news/")}>Read the news</a>
    </div>
  </section>
</Base>
