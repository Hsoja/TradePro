---
import Base from '../layouts/Base.astro';
const terminos = [
  ['Aceptación', 'Al crear una cuenta o usar TradePro aceptas estos términos. Si no estás de acuerdo, no utilices el servicio.'],
  ['Elegibilidad', 'Debes tener al menos 18 años y capacidad legal para contratar. Eres responsable de que el uso del servicio sea legal en tu país de residencia.'],
  ['Descripción del servicio', 'TradePro ofrece gráficos, datos de mercado, noticias y herramientas de análisis. Los datos y gráficos son proporcionados por terceros, como TradingView, y pueden tener retrasos o errores.'],
  ['Tu cuenta', 'Debes dar información veraz y mantener la confidencialidad de tus credenciales. Notifícanos de inmediato cualquier acceso no autorizado.'],
  ['Planes y pagos', 'Los planes de pago se renuevan de forma periódica hasta que los canceles. Puedes cancelar en cualquier momento y conservarás el acceso hasta el final del periodo pagado. Los precios pueden cambiar con aviso previo.'],
  ['Uso aceptable', 'No puedes usar el servicio para actividades ilegales, vulnerar su seguridad, extraer datos de forma automatizada sin permiso ni revender el acceso.'],
  ['Propiedad intelectual', 'La marca, el diseño y el software de TradePro pertenecen a sus titulares. Se te concede una licencia limitada, personal y revocable para usar el servicio.'],
  ['Limitación de responsabilidad', 'El servicio se ofrece "tal cual". En la medida permitida por la ley, TradePro no responde por pérdidas derivadas de decisiones de inversión, interrupciones del servicio o errores en datos de terceros.'],
  ['Terminación', 'Podemos suspender o cerrar cuentas que incumplan estos términos. Tú puedes cerrar tu cuenta en cualquier momento.'],
  ['Cambios y ley aplicable', 'Podemos actualizar estos términos y te avisaremos de los cambios relevantes. Se rigen por las leyes de México; las disputas se someterán a los tribunales competentes de Querétaro.'],
];
const privacidad = [
  ['Datos que recopilamos', 'Nombre, correo electrónico, plan elegido y los mensajes que nos envías por los formularios. También datos técnicos básicos de navegación.'],
  ['Para qué los usamos', 'Para crear y administrar tu cuenta, responder tus consultas, mejorar el servicio y cumplir obligaciones legales. No vendemos tus datos personales.'],
  ['Terceros', 'Usamos proveedores como TradingView (gráficos y datos) y un servicio de envío de formularios por correo. Cada uno procesa datos según su propia política.'],
  ['Tus derechos', 'Puedes solicitar acceso, rectificación, cancelación u oposición al tratamiento de tus datos (derechos ARCO) escribiéndonos desde el formulario de contacto.'],
];
const secs = [
  ['terminos', 'Términos y condiciones', terminos],
  ['privacidad', 'Política de privacidad', privacidad],
  ['riesgos', 'Aviso de riesgos', [['Riesgo de pérdida', 'Operar con acciones, divisas, criptomonedas, materias primas y derivados implica un alto riesgo. Puedes perder todo el capital invertido. El rendimiento pasado no garantiza resultados futuros.'], ['Sin asesoría', 'Nada en TradePro es asesoría financiera, legal o fiscal ni una recomendación de compra o venta. Invierte solo dinero que puedas permitirte perder y consulta a un profesional si lo necesitas.']]],
  ['cookies', 'Cookies', [['Uso de cookies', 'Usamos cookies y tecnologías similares necesarias para el funcionamiento del sitio y para los widgets de terceros como TradingView. Puedes bloquearlas desde la configuración de tu navegador, aunque algunas funciones podrían dejar de operar.']]],
];
---
<Base title="Términos y condiciones · TradePro">
<main class="wrap legal">
  <p class="mono" style="color:var(--mute);font-size:.8rem">Última actualización: 11 de octubre de 2026</p>
  <h1>Información legal</h1>
  <div class="toc">{secs.map(([id, t]) => <a href={'#' + id}>{t}</a>)}</div>
  {secs.map(([id, t, items]) => (
    <section id={id} class="glass">
      <h2>{t}</h2>
      {items.map(([h, p], i) => <><h3>{i + 1}. {h}</h3><p>{p}</p></>)}
    </section>
  ))}
</main>
</Base>
<style is:global>
  .legal{max-width:860px;padding-top:150px;padding-bottom:80px}
  .legal h1{font-size:clamp(2rem,4vw,3rem);font-weight:800;margin:.4rem 0 1.4rem}
  .toc{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:2rem}.toc a{border:1px solid var(--line);border-radius:99px;padding:.45rem 1rem;font-size:.85rem;color:var(--mute)}.toc a:hover{color:var(--cy);border-color:var(--cy)}
  .legal section{padding:clamp(22px,4vw,40px);margin-bottom:20px}.legal h2{font-size:1.5rem;margin-bottom:1rem}
  .legal h3{font-size:1rem;margin:1.2rem 0 .3rem}.legal p{color:#b9c6d6;line-height:1.7;font-size:.95rem}
</style>
