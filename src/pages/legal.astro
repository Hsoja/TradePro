import Base from "../layouts/Base.astro";
---

<Base title="Disclaimer and privacy | TradePro" description="TradePro's disclaimer, terms of use and privacy policy.">
  <div class="shell legal">
    <p class="draft-note">Draft for a portfolio project. Not reviewed by a lawyer.</p>
    <h1 class="title-lg">Disclaimer and privacy</h1>

    <h2 id="disclaimer" class="label-lg">Not financial advice</h2>
    <p>TradePro is an information site built as a portfolio project. Nothing on it is a recommendation to buy, sell or hold any security, currency, commodity or digital asset. Prices and news may be delayed or inaccurate. Trading involves risk, including the loss of your investment; speak to a licensed advisor before making financial decisions.</p>

    <h2 id="data" class="label-lg">Market data and news</h2>
    <p>Charts, quotes, heatmaps, headlines and the economic calendar are provided by TradingView through its public widgets, under TradingView's own terms. Headlines link to articles on tradingview.com and its news partners.</p>

    <h2 id="privacy" class="label-lg">Privacy</h2>
    <p>TradePro has no accounts, forms, cookies or analytics, and it doesn't collect or store any personal information. The site is served as static files.</p>
    <p>TradingView widgets load from tradingview-widget.com inside isolated frames. TradingView may receive your IP address and set its own cookies there, as described in its privacy policy. You can block third-party cookies in your browser without breaking the site.</p>

    <h2 id="terms" class="label-lg">Terms of use</h2>
    <p>The site is provided as is, without warranty. Don't attempt to disrupt it or test its security without permission; to report a vulnerability, use the private reporting option in the project's GitHub repository.</p>
  </div>
</Base>
