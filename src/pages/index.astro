---
import Base from "../layouts/Base.astro";
import TvWidget from "../components/TvWidget.astro";
import SessionBoard from "../components/SessionBoard.astro";
import { BONDS, MARKETS, getMarket } from "../data/markets";
import { cryptoHeatmap, economicCalendar, marketOverview, newsTimeline, stockHeatmap, topMovers } from "../lib/tradingview";
import { href } from "../lib/url";

const pick = (slug: string) => getMarket(slug)!.symbols.slice(0, 6);
const overview = marketOverview([
  { title: "Indices", symbols: pick("indices") },
  { title: "Futures", symbols: pick("futures") },
  { title: "Commodities", symbols: pick("commodities") },
  { title: "Crypto", symbols: pick("crypto") },
  { title: "Forex", symbols: pick("forex") },
  { title: "Bonds", symbols: BONDS },
]);
---

<Base>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="kicker"><span class="live-dot" aria-hidden="true"></span>Live market coverage</p>
      <h1 class="display">The news that moves markets, as it happens.</h1>
      <p class="lede">Headlines, prices and the economic calendar for stocks, crypto, futures, commodities and currencies, all on one screen.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={href("/news/")}>Read today's news</a>
        <a class="btn btn-ghost" href={href("/markets/")}>Browse markets</a>
      </div>
      <SessionBoard />
    </div>

    <section class="panel hero-news" aria-labelledby="top-stories">
      <div class="panel-head">
        <h2 id="top-stories" class="label-lg">Top stories</h2>
        <a class="text-link small" href={href("/news/")}>All news</a>
      </div>
      <TvWidget url={newsTimeline()} title="Top market stories" size="fill" eager />
    </section>
  </section>

  <section class="section shell" aria-labelledby="snapshot">
    <div class="section-head">
      <div>
        <h2 id="snapshot" class="title">Market snapshot</h2>
        <p class="muted">Today's move in the benchmarks across every asset class.</p>
      </div>
    </div>
    <div class="grid-2-1">
      <div class="panel">
        <TvWidget url={overview} title="Market overview by asset class" size="lg" />
      </div>
      <div class="panel">
        <div class="panel-head"><h3 class="label-lg">Top US movers</h3></div>
        <TvWidget url={topMovers("US")} title="Top US stock movers today" size="lg" />
      </div>
    </div>
  </section>

  <section class="section shell" aria-labelledby="flows">
    <div class="section-head">
      <div>
        <h2 id="flows" class="title">Where the money is moving</h2>
        <p class="muted">Each block is sized by market value and coloured by today's change.</p>
      </div>
    </div>
    <div class="panel" data-tabs>
      <div class="tablist" role="tablist" aria-label="Heatmaps">
        <button role="tab" id="tab-hm-stocks" aria-controls="panel-hm-stocks" aria-selected="true">S&amp;P 500</button>
        <button role="tab" id="tab-hm-crypto" aria-controls="panel-hm-crypto" aria-selected="false" tabindex="-1">Crypto</button>
      </div>
      <div role="tabpanel" id="panel-hm-stocks" aria-labelledby="tab-hm-stocks">
        <TvWidget url={stockHeatmap()} title="S&P 500 heatmap" size="xl" />
      </div>
      <div role="tabpanel" id="panel-hm-crypto" aria-labelledby="tab-hm-crypto" hidden>
        <TvWidget url={cryptoHeatmap()} title="Crypto heatmap" size="xl" deferred />
      </div>
    </div>
  </section>

  <section class="section shell" aria-labelledby="calendar">
    <div class="section-head">
      <div>
        <h2 id="calendar" class="title">On the economic calendar</h2>
        <p class="muted">Rate decisions, jobs and inflation reports: the scheduled events most likely to move prices.</p>
      </div>
      <a class="text-link" href={href("/calendar/")}>Full calendar</a>
    </div>
    <div class="panel">
      <TvWidget url={economicCalendar()} title="Economic calendar" size="lg" />
    </div>
  </section>

  <section class="section shell" aria-labelledby="markets-heading">
    <div class="section-head">
      <h2 id="markets-heading" class="title">Follow a market</h2>
    </div>
    <ul class="market-grid">
      {
        MARKETS.map((m) => (
          <li>
            <a class="market-card" href={href(`/markets/${m.slug}/`)}>
              <span class="market-card-name">{m.name}</span>
              <span class="market-card-lead mono">{m.lead.title}</span>
              <span class="market-card-text">{m.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
